/* =========================================================
   RAYKELS CATALOGUE & SHOP
   ========================================================= */

.catalogue-hero {
  padding: 150px 7% 90px;
  text-align: center;
  background: var(--cream);
}

.catalogue-hero .eyebrow {
  margin-bottom: 14px;
