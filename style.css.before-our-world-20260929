    font-size: 1.25rem;
  }
}


/* CATALOGUE FILTERS */
.catalogue-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 35px;
}

.catalogue-filter {
  border: 1px solid rgba(180, 154, 106, 0.45);
  background: transparent;
  color: var(--black);
  padding: 11px 18px;
  font-family: "Montserrat", sans-serif;
  font-size: 0.78rem;
  letter-spacing: 0.6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.catalogue-filter:hover,
.catalogue-filter.active {
  background: var(--black);
  color: var(--cream);
  border-color: var(--black);
}

@media (max-width: 600px) {
  .catalogue-filters {
    gap: 8px;
    margin-bottom: 25px;
  }

  .catalogue-filter {
    padding: 10px 13px;
    font-size: 0.72rem;
  }
}


/* =========================================
   RAYKELS HERO IMAGE SLIDESHOW
   ========================================= */

.hero {
  overflow: hidden;
  isolation: isolate;
}

.hero-slideshow {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
}

.hero-slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0;
  transform: scale(1.04);
  transition:
    opacity 1.4s ease-in-out,
    transform 7s ease-out;
}

.hero-slide.active {
  opacity: 1;
  transform: scale(1);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(
      90deg,
      rgba(15, 13, 11, .88),
      rgba(15, 13, 11, .55),
      rgba(15, 13, 11, .20)
    );
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
}

@media (max-width: 600px) {
  .hero {
    min-height: 90vh;
    padding: 120px 7%;
  }

  .hero-overlay {
    background:
      linear-gradient(
        90deg,
        rgba(15, 13, 11, .82),
        rgba(15, 13, 11, .48)
      );
  }

  .hero-slide {
    object-position: center;
  }
}


/* =========================================
   RAYKELS PRODUCT VARIANTS
   ========================================= */

.product-variants {
  margin: 28px 0;
}

.product-variant-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.product-variant-option {
  min-width: 120px;
  padding: 13px 16px;
  border: 1px solid rgba(0, 0, 0, .15);
  background: transparent;
  color: inherit;
  cursor: pointer;
  text-align: left;
  transition:
    border-color .25s ease,
    background .25s ease,
    transform .25s ease;
}

.product-variant-option:hover {
  transform: translateY(-1px);
}

.product-variant-option.active {
  border-color: var(--gold);
  background: rgba(0, 0, 0, .04);
}

.product-variant-option span {
  display: block;
  font-size: 13px;
  font-weight: 500;
}

.product-variant-option small {
  display: block;
  margin-top: 5px;
  font-size: 11px;
  opacity: .7;
}

.product-detail-price del {
  margin-left: 10px;
  opacity: .5;
  font-size: .8em;
}

.product-sale-price {
  font-weight: 600;
}

.product-variant-option:disabled {
  opacity: .45;
  cursor: not-allowed;
}

@media (max-width: 600px) {
  .product-variant-list {
    gap: 8px;
  }

  .product-variant-option {
    min-width: 105px;
    padding: 12px;
  }
}


/* =========================================================
   FEATURED PRODUCT CAROUSEL
   ========================================================= */

.featured-products-section {
  padding: 80px 20px;
  text-align: center;
}

.featured-products-section .section-heading {
  max-width: 720px;
  margin: 0 auto 35px;
}

.product-carousel {
  position: relative;
  max-width: 1250px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 12px;
}

.product-carousel-viewport {
  overflow: hidden;
  width: 100%;
}

.product-carousel-track {
  display: flex;
  gap: 20px;
  transition: transform 0.45s ease;
  will-change: transform;
}

.product-carousel-card {
  flex: 0 0 calc((100% - 40px) / 3);
  min-width: 0;
  text-align: left;
  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.product-carousel-media {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #f5f5f5;
}

.product-carousel-media img,
.product-carousel-media video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}


.product-carousel-info {
  padding: 18px 18px 20px;
}

.product-carousel-category {
  margin: 0 0 7px;
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0.6;
}

.product-carousel-name {
  margin: 0 0 10px;
  font-size: 17px;
  line-height: 1.35;
  font-weight: 500;
}

.product-carousel-price {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
}

.product-carousel-link {
  display: block;
  color: inherit;
  text-decoration: none;
}

.product-carousel-control {
  flex: 0 0 42px;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(0, 0, 0, 0.15);
  background: #fff;
  color: inherit;
  border-radius: 50%;
  cursor: pointer;
  font-size: 25px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-carousel-control:disabled {
  opacity: 0.35;
  cursor: default;
}

.product-carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin: 24px 0 18px;
}

.product-carousel-dot {
  width: 7px;
  height: 7px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.25;
  cursor: pointer;
}

.product-carousel-dot.is-active {
  opacity: 0.9;
}

.product-carousel-loading,
.product-carousel-empty {
  width: 100%;
  padding: 45px 20px;
  margin: 0;
  text-align: center;
  opacity: 0.65;
}

.featured-products-link {
  display: inline-block;
  margin-top: 5px;
}


@media (max-width: 900px) {
  .product-carousel-card {
    flex-basis: calc((100% - 20px) / 2);
  }
}

@media (max-width: 600px) {
  .featured-products-section {
    padding: 60px 15px;
  }

  .product-carousel {
    gap: 7px;
  }

  .product-carousel-card {
    flex-basis: 100%;
  }

  .product-carousel-control {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    font-size: 21px;
  }

  .product-carousel-info {
    padding: 15px;
  }
}


/* Carousel JS class compatibility */

.product-carousel-slide {
  flex: 0 0 100%;
  min-width: 0;
}

.product-carousel-product {
  display: block;
  color: inherit;
  text-decoration: none;
  background: #fff;
  overflow: hidden;
}

.product-carousel-media-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #f5f5f5;
}

.product-carousel-media-wrap .product-carousel-media {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-carousel-info h3 {
  margin: 0 0 10px;
  font-size: 17px;
  line-height: 1.35;
  font-weight: 500;
}

.product-carousel-info strong {
  font-size: 15px;
  font-weight: 600;
}

.product-carousel-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.15em;
  font-size: 12px;
}

.product-carousel-dot.active {
  opacity: 0.9;
}

@media (min-width: 901px) {
  .product-carousel-slide {
    flex-basis: 100%;
  }
}


/* =========================================================
   RAYKELS CANONICAL HERO CATALOGUE
   ========================================================= */

.hero.hero-catalogue {
  position: relative;
  min-height: 78vh;
  height: min(820px, 82vh);
  overflow: hidden;
  isolation: isolate;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
  background: #171117;
}

.hero-catalogue-media {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  touch-action: pan-y;
}

.hero-catalogue-track {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-catalogue-slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transform: scale(1.04);
  transition: opacity 900ms ease, transform 7s ease;
  pointer-events: none;
}

.hero-catalogue-slide.active {
  opacity: 1;
  visibility: visible;
  transform: scale(1);
  pointer-events: auto;
}

.hero-catalogue-media-element {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero-catalogue-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.38) 0%,
      rgba(0, 0, 0, 0.12) 42%,
      rgba(0, 0, 0, 0.56) 100%
    );
}

.hero-catalogue-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Fredoka", sans-serif;
  font-size: clamp(1.1rem, 3vw, 2rem);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  background: #171117;
}

.hero-catalogue-loading span {
  animation: raykelsHeroPulse 1.8s ease-in-out infinite;
}

@keyframes raykelsHeroPulse {
  0%, 100% {
    opacity: 0.45;
    transform: scale(0.98);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.hero-catalogue .hero-content {
  position: relative;
  z-index: 5;
  width: min(900px, 92%);
  margin: 0 auto;
}

.hero-catalogue .hero-buttons {
  position: relative;
  z-index: 6;
}

.hero-catalogue-controls {
  position: absolute;
  z-index: 8;
  left: 50%;
  bottom: 2rem;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
}

.hero-catalogue-arrow {
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: 50%;
  color: #fff;
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-size: 1.8rem;
  line-height: 1;
  cursor: pointer;
}

.hero-catalogue-arrow:hover,
.hero-catalogue-arrow:focus-visible {
  transform: scale(1.1);
  background: rgba(0, 0, 0, 0.5);
  outline: none;
}

.hero-catalogue-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  max-width: 45vw;
  overflow: hidden;
}

.hero-catalogue-dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  cursor: pointer;
}

.hero-catalogue-dot.active {
  width: 24px;
  border-radius: 999px;
  background: #fff;
}

.hero-catalogue-caption {
  position: absolute;
  z-index: 7;
  left: 1.5rem;
  bottom: 2rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.15rem;
  max-width: 35%;
  color: #fff;
  text-align: left;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
}

.hero-catalogue-caption-category {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  opacity: 0.8;
}

.hero-catalogue-caption strong {
  font-family: "Fredoka", sans-serif;
  font-size: clamp(0.95rem, 2vw, 1.25rem);
}

@media (max-width: 700px) {
  .hero.hero-catalogue {
    min-height: 72vh;
    height: 72vh;
  }

  .hero-catalogue-controls {
    bottom: 1.2rem;
    gap: 0.55rem;
  }

  .hero-catalogue-arrow {
    width: 36px;
    height: 36px;
    font-size: 1.45rem;
  }

  .hero-catalogue-dots {
    max-width: 42vw;
    gap: 0.35rem;
  }

  .hero-catalogue-dot {
    width: 6px;
    height: 6px;
  }

  .hero-catalogue-dot.active {
    width: 18px;
  }

  .hero-catalogue-caption {
    left: 1rem;
    right: 1rem;
    bottom: 4.8rem;
    max-width: calc(100% - 2rem);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-catalogue-slide {
    transition: opacity 300ms ease;
    transform: none;
  }

  .hero-catalogue-slide.active {
    transform: none;
  }

  .hero-catalogue-loading span {
    animation: none;
  }
}

/* Opening brand message yields visual priority to catalogue media */
.hero-catalogue .hero-content {
  transition: opacity 900ms ease, transform 900ms ease;
}

.hero-catalogue .hero-content.hero-message-faded {
  opacity: 0;
  transform: translateY(-12px);
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .hero-catalogue .hero-content {
    transition: none;
  }

  .hero-catalogue .hero-content.hero-message-faded {
    opacity: 1;
    transform: none;
  }
}
